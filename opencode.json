{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp/*": "allow"
    },
    "websearch": "deny"
  },
  "mcp": {
    "servers": {
      "render": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote",
          "https://mcp.render.com/mcp",
          "--header",
          "Authorization: Bearer ${RENDER_API_KEY}"
        ],
        "environment": {
          "RENDER_API_KEY": "{env:RENDER_API_KEY}"
        }
      }
    }
  }
}
